# ==========================================
# AutoAttend - Environment Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# Flask Session Secret Key (Generate a random string)
SECRET_KEY=your_secret_key_here

# Email Notifications (SMTP - Gmail)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_digit_gmail_app_password
SUPPORT_EMAIL=your_support_email@gmail.com

# Resend API (Alternative Cloud Email Service, Optional)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=AutoAttend <onboarding@resend.dev>

# Database Configuration (MySQL / Cloud Database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=attendance_system

# Face Recognition Configuration
RECOGNITION_THRESHOLD=65
REQUIRED_MATCH_FRAMES=5
